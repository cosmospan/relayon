{
  "name": "@relayon/connector-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Connector interface, defineTool, HTTP client and test harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests=false"
  },
  "dependencies": {
    "@relayon/core": "workspace:*",
    "@relayon/net": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@relayon/config": "workspace:*"
  }
}
