{
  "name": "@relayon/net",
  "version": "0.0.0",
  "private": true,
  "description": "safeFetch (SSRF guard with DNS pinning) and the credential redactor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
