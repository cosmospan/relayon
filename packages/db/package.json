{
  "name": "@relayon/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema and migrations for the main DB (RLS forced on tenant tables)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests=false",
    "migrate": "node dist/cli.js --dev-roles"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@relayon/config": "workspace:*",
    "@types/pg": "^8.15.0"
  }
}
