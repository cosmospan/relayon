# Local development only. Never put real provider credentials here; never commit .env.
# Run `pnpm dev:keys` once to create the files under .dev-keys/ (gitignored).
NODE_ENV=development

# ---- Main DB ----
# Migrations run as the owner; the API connects as relayon_app (non-owner, NOBYPASSRLS).
DATABASE_MIGRATE_URL=postgres://relayon_owner:relayon_owner@localhost:5432/relayon
DATABASE_URL=postgres://relayon_app:relayon_app@localhost:5432/relayon
# The Executor re-checks actions through a read-only role (§11.2).
EXECUTOR_MAIN_DATABASE_URL=postgres://relayon_executor_ro:relayon_executor_ro@localhost:5432/relayon

# ---- Vault DB (separate instance; only executor + connect reach it) ----
VAULT_DATABASE_MIGRATE_URL=postgres://relayon_vault:relayon_vault@localhost:5433/relayon_vault
EXECUTOR_VAULT_DATABASE_URL=postgres://relayon_executor:relayon_executor@localhost:5433/relayon_vault
CONNECT_VAULT_DATABASE_URL=postgres://relayon_connect:relayon_connect@localhost:5433/relayon_vault

REDIS_URL=redis://localhost:6379

# S3-compatible object storage for large snapshots (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=relayon-snapshots
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ---- Keys (dev) ----
# KEY_PROVIDER=dev refuses to start when NODE_ENV=production; production uses aws-kms.
KEY_PROVIDER=dev
DEV_MASTER_KEY_FILE=.dev-keys/master-key.hex
API_KEY_PEPPER_FILE=.dev-keys/api-key-pepper.hex
SNAPSHOT_KEY_FILE=.dev-keys/snapshot-key.hex
INTERNAL_SIGNING_KEY_FILE=.dev-keys/internal-signing.pem
INTERNAL_SIGNING_PUBLIC_KEY_FILE=.dev-keys/internal-signing.pub.pem

# Egress proxy for all outbound provider traffic
EGRESS_PROXY_URL=http://localhost:4750
# Comma-separated internal domains safeFetch must never reach
RELAYON_INTERNAL_DOMAINS=

API_PORT=8787
EXECUTOR_URL=http://127.0.0.1:8788
CONNECT_URL=http://127.0.0.1:8789
DASHBOARD_URL=http://localhost:3000
# Browser origins allowed to call /mcp (comma-separated). Requests with any other Origin get 403.
MCP_ALLOWED_ORIGINS=
