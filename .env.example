# Local development only. Never put real provider credentials here; never commit .env.
NODE_ENV=development

# Main DB (app role is non-owner; RLS is forced on tenant tables)
DATABASE_URL=postgres://relayon_app:relayon_app@localhost:5432/relayon
DATABASE_MIGRATE_URL=postgres://relayon_owner:relayon_owner@localhost:5432/relayon

# Vault DB (reachable only by executor + connect)
VAULT_DATABASE_URL=postgres://relayon_vault:relayon_vault@localhost:5433/relayon_vault

REDIS_URL=redis://localhost:6379

# S3-compatible object storage for large snapshots (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=relayon-snapshots
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Key provider: "dev" refuses to start when NODE_ENV=production
KEY_PROVIDER=dev
DEV_MASTER_KEY_FILE=./.dev-master-key

# Pepper for HMAC-hashing API keys (generate locally: openssl rand -hex 32)
API_KEY_PEPPER=

# Egress proxy for all outbound provider traffic
EGRESS_PROXY_URL=http://localhost:4750

API_PORT=8787
DASHBOARD_URL=http://localhost:3000
